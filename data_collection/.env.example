# Product Hunt: https://api.producthunt.com/v2/oauth/applications
# Crea una app, usa el "Developer Token" que te dan directo (no requiere
# completar el flujo OAuth de usuario para lectura publica).
PRODUCTHUNT_TOKEN=

# Reddit: https://www.reddit.com/prefs/apps -> crea una app tipo "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=solopreneur-research by u/TU_USUARIO

# Census NES: registro instantaneo por email, sin captcha
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
